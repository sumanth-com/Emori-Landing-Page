# ——— Website (Vite) ———
# Local dev: copy to `.env`
# Production builds: `.env.production` (committed) or set in your host dashboard
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Public site URL — used for the logo in lead notification emails (/brand/emori-logo.png)
VITE_SITE_URL=https://your-live-site.com

# ——— Resend (lead notification emails) ———
# These are NOT used by the React app. Add them in Google Apps Script instead:
#   1. Run setupConfigSheet() once in Apps Script
#   2. Open the **Config** tab in your Google Sheet
#   3. Paste RESEND_API_KEY and other values there
#   4. Run testLeadEmail() once to verify delivery
#
# Get your API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Must be a verified sender in Resend (use onboarding@resend.dev for testing)
RESEND_FROM_EMAIL=EMORI Franchise <contact@ifranchise.in>

# Inbox that receives new franchise leads
LEAD_NOTIFICATION_EMAIL=contact@ifranchise.in
